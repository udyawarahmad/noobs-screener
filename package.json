{
  "name": "noobs-screener",
  "productName": "Noobs Screener",
  "version": "1.2.0",
  "description": "Noobs Screener — one-page Indian stock screener (live prices, financials, ratios, shareholding).",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable zip --publish never",
    "test": "node test/persistence.test.js && node test/news.test.js && node test/renderer.smoke.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^31.0.1"
  },
  "build": {
    "appId": "com.noobs.screener",
    "productName": "Noobs Screener",
    "files": [
      "main.js",
      "main-store.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Noobs Screener",
      "artifactName": "Noobs-Screener-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Noobs-Screener-Portable-${version}.exe"
    }
  }
}
